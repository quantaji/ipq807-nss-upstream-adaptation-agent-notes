+/* E-0007 experiment only: note from where the packet is sent and how long
+ * the driver takes over it
+ */
+static netdev_tx_t ppe_netdev_xmit(struct sk_buff *skb,
+				   struct net_device *netdev)
+{
+	unsigned int len = skb->len;
+	netdev_tx_t ret;
+	bool local;
+	u64 start;
+
+	diag_xmit_begin(skb, &start, &local);
+	ret = ppe_netdev_xmit_one(skb, netdev);
+	diag_xmit_end(start, local, len, ret == NETDEV_TX_BUSY);
+
+	return ret;
+}
