+/* An interrupt of @ring asked for its poll */
+void diag_irq(struct edma_ring *ring)
+{
+	if (!diag_on)
+		return;
+
+	ring->diag.irqs++;
+	WRITE_ONCE(ring->diag.irq_ts, diag_now());
+}
+
+/* Bottom halves are off around a poll, in a thread too */
+void diag_poll_begin(struct edma_ring *ring, bool tx)
+{
+	struct diag_ring *d = &ring->diag;
+	struct diag_poll *p = &d->cur;
+	struct diag_cpu *c;
+	u64 now, irq_ts;
+
+	if (!diag_on) {
+		p->start = 0;
+		return;
+	}
+
+	c = this_cpu_ptr(&diag_cpu);
+	now = diag_now();
+	memset(p, 0, sizeof(*p));
+	p->start = now;
+
+	irq_ts = READ_ONCE(d->irq_ts);
+	WRITE_ONCE(d->irq_ts, 0);
+	p->since_irq = irq_ts ? min_t(u64, now - irq_ts, U32_MAX - 1) : U32_MAX;
+	p->gap = d->last_end ? min_t(u64, now - d->last_end, U32_MAX) : U32_MAX;
+	p->cpu = smp_processor_id();
+	p->pid = current->pid;
+	if (tx) {
+		p->flags |= DIAG_POLL_TX;
+		p->after_loc = c->x_soft_loc - d->soft_loc_at_end;
+	}
+	if (in_hardirq()) {
+		p->flags |= DIAG_POLL_HARDIRQ;
+	} else if (in_serving_softirq()) {
+		p->flags |= DIAG_POLL_SOFTIRQ;
+		if (c->cur_class == DIAG_T_KSOFTIRQD)
+			p->flags |= DIAG_POLL_KSOFTIRQD;
+	}
+
+	d->cur_xmit_loc = c->x_loc;
+	d->cur_xmit_fwd = c->x_fwd;
+	d->cur_xmit_ns = c->x_ns_all;
+	d->saved_in_poll = c->in_poll;
+	c->in_poll = tx ? 2 : 1;
+}
+
+void diag_poll_end(struct edma_ring *ring, int done, int budget, u16 q_out)
+{
+	struct diag_ring *d = &ring->diag;
+	struct diag_poll *p = &d->cur;
+	struct diag_cpu *c;
+	u64 now;
+
+	if (!p->start)
+		return;
+
+	c = this_cpu_ptr(&diag_cpu);
+	c->in_poll = d->saved_in_poll;
+	d->soft_loc_at_end = c->x_soft_loc;
+	now = diag_now();
+
+	p->dur = now - p->start;
+	p->n = done;
+	p->q_out = q_out;
+	if (done >= budget)
+		p->flags |= DIAG_POLL_BUDGET;
+	p->xmit_loc = c->x_loc - d->cur_xmit_loc;
+	p->xmit_fwd = c->x_fwd - d->cur_xmit_fwd;
+	p->xmit_ns = c->x_ns_all - d->cur_xmit_ns;
+	d->last_end = now;
+
+	d->dur += p->dur;
+	d->n += p->n;
+	d->frames += p->frames;
+	d->fwd += p->fwd;
+	d->loc += p->loc;
+	d->ack += p->ack;
+	d->scan += p->scan;
+	d->xmit_loc += p->xmit_loc;
+	d->xmit_fwd += p->xmit_fwd;
+	d->xmit_ns += p->xmit_ns;
+	d->woken += p->woken;
+	if (p->flags & DIAG_POLL_BUDGET)
+		d->budget++;
+	if (p->since_irq != U32_MAX) {
+		d->from_irq++;
+		diag_hist_add(d->hist_since_irq, p->since_irq);
+	} else if (p->gap != U32_MAX) {
+		diag_hist_add(d->hist_gap, p->gap);
+	}
+	diag_hist_add(d->hist_n, p->n);
+	diag_hist_add(d->hist_q, p->q_in);
+
+	if (d->rec)
+		d->rec[d->polls % diag_cap] = *p;
+	d->polls++;
+	p->start = 0;
+}
+
+/* The first buffer of a frame, from the Ethernet header on. Says whether the
+ * frame is to be dropped.
+ */
+bool diag_rx_frame(struct edma_ring *ring, const void *frame, unsigned int len)
+{
+	struct diag_poll *p = &ring->diag.cur;
+	const struct ethhdr *eth = frame;
+	const struct iphdr *ip = frame + ETH_HLEN;
+	const struct udphdr *udp;
+	const struct tcphdr *tcp;
+	unsigned int port, i;
+
+	p->frames++;
+
+	if (len < ETH_HLEN + sizeof(*ip) + sizeof(*tcp) ||
+	    eth->h_proto != htons(ETH_P_IP))
+		return false;
+
+	if (ip->protocol == IPPROTO_UDP) {
+		udp = (void *)ip + ip->ihl * 4;
+		port = ntohs(udp->dest);
+
+		if (port == DIAG_MARK_PORT) {
+			i = (unsigned int)atomic_inc_return(&diag_mark_n) - 1;
+			diag_mark[i % DIAG_MARKS].seq =
+				get_unaligned_be32(udp + 1);
+			diag_mark[i % DIAG_MARKS].at = diag_now();
+		}
+
+		if (exp_rx_drop_port && port >= exp_rx_drop_port &&
+		    port < exp_rx_drop_port + 100) {
+			if (diag_on)
+				ring->diag.dropped++;
+			return true;
+		}
+	}
+
+	tcp = (void *)ip + ip->ihl * 4;
+
+	/* The addresses of the router in the experiment all end in .1 */
+	if ((ntohl(ip->daddr) & 0xff) != 1 ||
+	    ((ip->protocol == IPPROTO_UDP || ip->protocol == IPPROTO_TCP) &&
+	     (ntohs(tcp->source) == diag_fwd_port ||
+	      ntohs(tcp->dest) == diag_fwd_port))) {
+		p->fwd++;
+		return false;
+	}
+
+	if (ip->protocol == IPPROTO_TCP &&
+	    ntohs(ip->tot_len) == ip->ihl * 4 + tcp->doff * 4)
+		p->ack++;
+	else
+		p->loc++;
+
+	return false;
+}
+
+/* Called with bottom halves off, like the xmit itself */
+void diag_xmit_begin(struct sk_buff *skb, u64 *start, bool *local)
+{
+	*start = 0;
+	*local = skb->sk;
+	if (!diag_on)
+		return;
+
+	if (skb_is_nonlinear(skb))
+		this_cpu_ptr(&diag_cpu)->x_nonlinear++;
+	if (diag_xmit_time)
+		*start = diag_now();
+}
+
+void diag_xmit_end(u64 start, bool local, unsigned int len, bool busy)
+{
+	struct diag_cpu *c;
+	int ctx;
+	u64 dt;
+
+	if (!diag_on)
+		return;
+
+	c = this_cpu_ptr(&diag_cpu);
+	if (c->in_poll)
+		ctx = c->in_poll == 1 ? DIAG_X_RXPOLL : DIAG_X_TXPOLL;
+	else if (c->cur_vec == NET_TX_SOFTIRQ)
+		ctx = DIAG_X_NET_TX;
+	else if (c->cur_vec == TASKLET_SOFTIRQ)
+		ctx = DIAG_X_TASKLET;
+	else if (c->cur_vec == TIMER_SOFTIRQ || c->cur_vec == HRTIMER_SOFTIRQ)
+		ctx = DIAG_X_TIMER;
+	else if (c->cur_vec >= 0)
+		ctx = DIAG_X_SOFTIRQ;
+	else
+		ctx = c->cur_class == DIAG_T_GEN ? DIAG_X_GEN : DIAG_X_PROC;
+
+	if (busy) {
+		c->x_busy++;
+	} else {
+		c->x_pkts[ctx][local]++;
+		c->x_bytes[ctx][local] += len;
+		if (local)
+			c->x_loc++;
+		else
+			c->x_fwd++;
+		if (local && ctx >= DIAG_X_NET_TX && ctx <= DIAG_X_SOFTIRQ)
+			c->x_soft_loc++;
+	}
+
+	if (start) {
+		dt = diag_now() - start;
+		c->x_ns[ctx] += dt;
+		c->x_ns_all += dt;
+	}
+}
+
+/* The driver's poll that only hands frames to the stack (exp_rx_hardirq) */
+void diag_in_poll(u8 kind)
+{
+	this_cpu_ptr(&diag_cpu)->in_poll = kind;
+}
+
+/* What the sampler reads of TX queue @i: bytes the stack has handed over
+ * that are not reported as sent, the limit on those, packets and bytes that
+ * wait in the queue's qdisc
+ */
+static void diag_txq_sample(unsigned int i, u32 *val)
+{
+	struct netdev_queue *txq = netdev_get_tx_queue(diag_txq[i].port->netdev,
+						       diag_txq[i].queue);
+	struct Qdisc *qdisc = rcu_dereference_raw(txq->qdisc);
+
+	val[0] = txq->dql.num_queued - txq->dql.num_completed;
+	val[1] = txq->dql.limit;
+	val[2] = qdisc ? qdisc->q.qlen : 0;
+	val[3] = qdisc ? qdisc->qstats.backlog : 0;
+}
+
+/* The totals of every TX queue: packets put into its ring, how often it was
+ * stopped, woken by the completion poll, woken again by the sending side,
+ * and what its qdisc dropped and took back
+ */
+static void diag_txq_totals(u64 (*val)[DIAG_TXQ_TOTALS])
+{
+	unsigned int i;
+
+	for (i = 0; i < diag_ntxq; i++) {
+		struct ppe_port *port = diag_txq[i].port;
+		u8 q = diag_txq[i].queue;
+		struct Qdisc *qdisc = rcu_dereference_raw(netdev_get_tx_queue(port->netdev, q)->qdisc);
+
+		val[i][0] = port->tx_ring_packets[q];
+		val[i][1] = port->tx_ring_stopped[q];
+		val[i][2] = port->tx_ring_woken[q];
+		val[i][3] = port->tx_ring_rewoken[q];
+		val[i][4] = qdisc ? qdisc->qstats.drops : 0;
+		val[i][5] = qdisc ? qdisc->qstats.requeues : 0;
+	}
+}
+
+static enum hrtimer_restart diag_sample_fn(struct hrtimer *timer)
+{
+	u64 t0 = diag_now();
+	unsigned int i;
+	u32 *r;
+
+	if (diag.n >= diag.cap) {
+		diag.running = false;
+		return HRTIMER_NORESTART;
+	}
+
+	r = diag.buf + diag.n * diag.rec_words;
+	r[0] = t0;
+	r[1] = t0 >> 32;
+	for (i = 0; i < diag.rec_regs; i++)
+		r[3 + i] = readl(diag.base + diag.regs[i]);
+	for (i = 0; i < diag_ntxq; i++)
+		diag_txq_sample(i, r + 3 + diag.rec_regs + DIAG_TXQ_SAMPLE * i);
+	r[2] = diag_now() - t0;
+	diag.sample_ns += r[2];
+	diag.n++;
+
+	hrtimer_forward_now(timer, diag.period);
+
+	return HRTIMER_RESTART;
+}
+
+static void diag_sample_start(void *unused)
+{
+	hrtimer_start(&diag.timer, diag.period, HRTIMER_MODE_REL_PINNED_HARD);
+}
+
+static int diag_watch_fn(void *unused)
+{
+	u64 end = diag_now() + (u64)diag.wms * NSEC_PER_MSEC;
+	u32 last[DIAG_WREGS_MAX];
+	u64 loops = 0;
+	u64 now;
+	unsigned int i;
+	u32 val;
+
+	for (i = 0; i < diag.nwregs; i++)
+		last[i] = ~readl(diag.base + diag.wregs[i]);
+
+	do {
+		now = diag_now();
+		for (i = 0; i < diag.nwregs; i++) {
+			val = readl(diag.base + diag.wregs[i]);
+			if (val == last[i] || diag.wn >= diag.wcap)
+				continue;
+
+			last[i] = val;
+			diag.wbuf[2 * diag.wn] = now;
+			diag.wbuf[2 * diag.wn + 1] = (u64)i << 32 | val;
+			diag.wn++;
+		}
+		loops++;
+	} while (now < end);
+
+	diag.wloops = loops;
+	diag.wdone = true;
+	diag.watcher = NULL;
+
+	return 0;
+}
+
+static void diag_reset_cpu(void *unused)
+{
+	struct diag_cpu *c = this_cpu_ptr(&diag_cpu);
+	u64 now = diag_now();
+
+	memset(c->irq_ns, 0, sizeof(c->irq_ns));
+	memset(c->irq_cnt, 0, sizeof(c->irq_cnt));
+	memset(c->sirq_ns, 0, sizeof(c->sirq_ns));
+	memset(c->sirq_cnt, 0, sizeof(c->sirq_cnt));
+	memset(c->sirq_ksoftirqd_ns, 0, sizeof(c->sirq_ksoftirqd_ns));
+	memset(c->task_ns, 0, sizeof(c->task_ns));
+	memset(c->task_sw, 0, sizeof(c->task_sw));
+	memset(c->x_pkts, 0, sizeof(c->x_pkts));
+	memset(c->x_bytes, 0, sizeof(c->x_bytes));
+	memset(c->x_ns, 0, sizeof(c->x_ns));
+	c->x_busy = 0;
+	c->x_nonlinear = 0;
+	c->gen_wait_ns = 0;
+	c->gen_wait_cnt = 0;
+	c->gen_wait_max = 0;
+	memset(c->hist_gen_wait, 0, sizeof(c->hist_gen_wait));
+	c->since = now;
+	c->switch_ts = now;
+	c->stolen = 0;
+	c->sirq_ts = now;
+	c->sirq_stolen = 0;
+	c->cur_class = diag_task_class(current);
+}
+
+static void diag_reset_ring(struct edma_ring *ring)
+{
+	struct diag_ring *d = &ring->diag;
+	struct diag_poll *rec = d->rec;
+
+	/* The records themselves are left as they are: clearing them takes
+	 * long enough for an RX ring to fill up meanwhile. Each carries when
+	 * its poll began, which tells the old ones from the new.
+	 */
+	memset(d, 0, offsetof(struct diag_ring, cur));
+	d->rec = rec;
+}
+
+/* The polls go on meanwhile: a count may be off by what one poll adds */
+static void diag_reset(void)
+{
+	struct edma *edma = &diag.ppe_dev->edma;
+	struct diag_thread *t;
+	int i;
+
+	for (i = 0; i < edma->num_rx; i++)
+		diag_reset_ring(&edma->rxdesc[i]);
+	for (i = 0; i < edma->num_txcmpl; i++)
+		diag_reset_ring(&edma->txcmpl[i]);
+
+	for (i = 0; i < DIAG_THREADS; i++) {
+		t = &diag_thread[i];
+		t->wake_ns = 0;
+		t->wake_cnt = 0;
+		t->wake_max = 0;
+		t->pre_ns = 0;
+		t->pre_cnt = 0;
+		t->pre_max = 0;
+		memset(t->hist_wake, 0, sizeof(t->hist_wake));
+		memset(t->hist_pre, 0, sizeof(t->hist_pre));
+	}
+
+	diag_txq_totals(diag_txq_base);
+	memset(diag_txq_end, 0, sizeof(diag_txq_end));
+	on_each_cpu(diag_reset_cpu, NULL, 1);
+}
+
+static enum hrtimer_restart diag_window_fn(struct hrtimer *timer)
+{
+	WRITE_ONCE(diag_on, false);
+	diag.win_stop = diag_now();
+	diag_txq_totals(diag_txq_end);
+
+	return HRTIMER_NORESTART;
+}
+
+/* Keep every CPU busy with interrupts off for a while: what a kernel that
+ * hangs looks like to the watchdog, but it ends by itself
+ */
+static void diag_stall_cpu(void *arg)
+{
+	unsigned int sec = *(unsigned int *)arg;
+
+	while (sec--)
+		mdelay(1000);
+}
+
+static void diag_set_prio(struct diag_thread *t, int prio)
+{
+	if (!t->task)
+		return;
+
+	if (prio == 100)
+		sched_set_fifo_low(t->task);
+	else if (prio == 101)
+		sched_set_fifo(t->task);
+	else
+		sched_set_normal(t->task, clamp(prio, -20, 19));
+}
+
+/* What can be written to ctl, one command a write:
+ * reset
+ * run <ms>			reset, record for that long, then stop
+ * stall <seconds>		all CPUs busy with interrupts off for that long
+ * regs <offset>...		the registers the sampler reads; regs+ adds more
+ * sample <us> <cpu> <count>	start the sampler; "sample 0" stops it
+ * wregs <offset>...		the registers the watcher reads, at most 8
+ * watch <cpu> <ms> <count>	watch for that long, keep that many changes
+ * ictl rx|tx <n>		write the interrupt control registers of the host's
+ *				RX rings or TX completion rings
+ * mod rx|tx <n>		write the moderation timers of the host's RX rings
+ *				or TX completion rings
+ * prio rx|tx <n>		the NAPI threads: nice -20 to 19, 100 for the
+ *				lowest real-time priority, 101 for a middle one
+ */
+static ssize_t diag_ctl_write(struct file *file, const char __user *ubuf,
+			      size_t len, loff_t *ppos)
+{
+	unsigned int us, cpu, count, ms, n;
+	char buf[768];
+	char *s, *tok;
+	int prio, i;
+	u32 *regs;
+	u32 reg;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = 0;
+	s = strim(buf);
+
+	if (!strcmp(s, "reset")) {
+		diag_reset();
+		return len;
+	}
+
+	if (sscanf(s, "run %u", &ms) == 1) {
+		if (!ms || ms > 600000)
+			return -EINVAL;
+
+		hrtimer_cancel(&diag.window);
+		WRITE_ONCE(diag_on, false);
+		diag_reset();
+		diag.win_stop = 0;
+		diag.win_start = diag_now();
+		WRITE_ONCE(diag_on, true);
+		hrtimer_start(&diag.window, ms_to_ktime(ms), HRTIMER_MODE_REL);
+		return len;
+	}
+
+	if (sscanf(s, "stall %u", &count) == 1) {
+		static unsigned int stall_sec;
+
+		if (!count || count > 180)
+			return -EINVAL;
+
+		stall_sec = count;
+		on_each_cpu(diag_stall_cpu, &stall_sec, 0);
+		return len;
+	}
+
+	if (!strncmp(s, "regs", 4) || !strncmp(s, "wregs", 5)) {
+		bool watch = s[0] == 'w';
+
+		if (watch ? !!diag.watcher : diag.running)
+			return -EBUSY;
+
+		regs = watch ? diag.wregs : diag.regs;
+		/* "regs+" adds to the list */
+		n = !watch && s[4] == '+' ? diag.nregs : 0;
+		strsep(&s, " ");
+		while ((tok = strsep(&s, " ")) != NULL) {
+			if (!*tok)
+				continue;
+			if (n >= (watch ? DIAG_WREGS_MAX : DIAG_REGS_MAX) ||
+			    kstrtou32(tok, 16, &reg) || reg & 3 ||
+			    reg >= 0xbb0000)
+				return -EINVAL;
+			regs[n++] = reg;
+		}
+		if (watch)
+			diag.nwregs = n;
+		else
+			diag.nregs = n;
+		return len;
+	}
+
+	if (sscanf(s, "sample %u %u %u", &us, &cpu, &count) >= 1) {
+		hrtimer_cancel(&diag.timer);
+		diag.running = false;
+		if (!us)
+			return len;
+		if (sscanf(s, "sample %u %u %u", &us, &cpu, &count) != 3 ||
+		    !cpu_online(cpu) || !count || !diag.nregs)
+			return -EINVAL;
+
+		/* A buffer that is big enough is used again, as it is: getting
+		 * and clearing a new one stalls the CPU this runs on
+		 */
+		diag.rec_regs = diag.nregs;
+		diag.rec_words = 3 + diag.rec_regs + DIAG_TXQ_SAMPLE * diag_ntxq;
+		if ((size_t)count * diag.rec_words > diag.buf_words) {
+			vfree(diag.buf);
+			diag.buf_words = 0;
+			diag.blob.size = 0;
+			diag.buf = vmalloc(array3_size(count, diag.rec_words,
+						       sizeof(u32)));
+			if (!diag.buf)
+				return -ENOMEM;
+			diag.buf_words = (size_t)count * diag.rec_words;
+		}
+		diag.cap = count;
+		diag.n = 0;
+		diag.sample_ns = 0;
+		diag.blob.data = diag.buf;
+		diag.blob.size = (size_t)count * diag.rec_words * sizeof(u32);
+		diag.period = ns_to_ktime((u64)us * NSEC_PER_USEC);
+		diag.running = true;
+		smp_call_function_single(cpu, diag_sample_start, NULL, 1);
+		return len;
+	}
+
+	if (sscanf(s, "watch %u %u %u", &cpu, &ms, &count) == 3) {
+		if (diag.watcher || !cpu_online(cpu) || !count ||
+		    !diag.nwregs || ms > 5000)
+			return -EINVAL;
+
+		if (count > diag.wbuf_cap) {
+			vfree(diag.wbuf);
+			diag.wbuf_cap = 0;
+			diag.wblob.size = 0;
+			diag.wbuf = vmalloc(array3_size(count, 2, sizeof(u64)));
+			if (!diag.wbuf)
+				return -ENOMEM;
+			diag.wbuf_cap = count;
+		}
+		diag.wcap = count;
+		diag.wn = 0;
+		diag.wms = ms;
+		diag.wdone = false;
+		diag.wblob.data = diag.wbuf;
+		diag.wblob.size = (size_t)count * 2 * sizeof(u64);
+		diag.watcher = kthread_run_on_cpu(diag_watch_fn, NULL, cpu,
+						  "diag_watch");
+		if (IS_ERR(diag.watcher)) {
+			diag.watcher = NULL;
+			return -ENOMEM;
+		}
+		return len;
+	}
+
+	if (sscanf(s, "ictl rx %u", &count) == 1) {
+		struct edma *edma = &diag.ppe_dev->edma;
+
+		for (i = 0; i < edma->num_rx; i++)
+			writel(count, diag.base + EDMA_BASE_OFFSET +
+			       EDMA_REG_RX_INT_CTRL(edma->rxdesc[i].id));
+		return len;
+	}
+
+	if (sscanf(s, "ictl tx %u", &count) == 1) {
+		struct edma *edma = &diag.ppe_dev->edma;
+		u32 base = diag.ppe_dev->soc->edma_tx_int_base;
+
+		for (i = 0; i < edma->num_txcmpl; i++)
+			writel(count, diag.base + EDMA_BASE_OFFSET +
+			       EDMA_REG_TX_INT_CTRL(base, edma->txcmpl[i].id));
+		return len;
+	}
+
+	if (sscanf(s, "mod rx %u", &count) == 1) {
+		struct edma *edma = &diag.ppe_dev->edma;
+
+		for (i = 0; i < edma->num_rx; i++)
+			writel(count, diag.base + EDMA_BASE_OFFSET +
+			       EDMA_REG_RX_MOD_TIMER(edma->rxdesc[i].id));
+		return len;
+	}
+
+	if (sscanf(s, "mod tx %u", &count) == 1) {
+		struct edma *edma = &diag.ppe_dev->edma;
+		u32 base = diag.ppe_dev->soc->edma_tx_int_base;
+
+		for (i = 0; i < edma->num_txcmpl; i++)
+			writel(count, diag.base + EDMA_BASE_OFFSET +
+			       EDMA_REG_TX_MOD_TIMER(base, edma->txcmpl[i].id));
+		return len;
+	}
+
+	if (sscanf(s, "prio rx %d", &prio) == 1) {
+		for (i = 0; i < EDMA_MAX_RX_GROUPS; i++)
+			diag_set_prio(&diag_thread[i], prio);
+		return len;
+	}
+
+	if (sscanf(s, "prio tx %d", &prio) == 1) {
+		for (i = EDMA_MAX_RX_GROUPS; i < DIAG_THREADS; i++)
+			diag_set_prio(&diag_thread[i], prio);
+		return len;
+	}
+
+	return -EINVAL;
+}
+
+static const struct file_operations diag_ctl_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = diag_ctl_write,
+};
+
+static void diag_show_u64s(struct seq_file *m, const char *name,
+			   const u64 *val, int n)
+{
+	int i;
+
+	seq_puts(m, name);
+	for (i = 0; i < n; i++)
+		seq_printf(m, " %llu", val[i]);
+	seq_putc(m, '\n');
+}
+
+static void diag_show_ring(struct seq_file *m, const char *kind, int idx,
+			   struct edma_ring *ring)
+{
+	struct diag_ring *d = &ring->diag;
+	char name[32];
+
+	seq_printf(m, "ring %s%d id=%u irq=%d polls=%llu dur=%llu n=%llu frames=%llu fwd=%llu loc=%llu ack=%llu scan=%llu scans=%llu dropped=%llu xmit_loc=%llu xmit_fwd=%llu xmit_ns=%llu woken=%llu budget=%llu from_irq=%llu irqs=%llu count=%u swq_done=%llu swq_drop=%llu leaked=%llu\n",
+		   kind, idx, ring->id, ring->irq, d->polls, d->dur, d->n,
+		   d->frames, d->fwd, d->loc, d->ack, d->scan, d->scans,
+		   d->dropped, d->xmit_loc, d->xmit_fwd, d->xmit_ns, d->woken,
+		   d->budget, d->from_irq, d->irqs, ring->count, d->swq_done,
+		   d->swq_drop, d->leaked);
+
+	snprintf(name, sizeof(name), "hist %s%d since_irq", kind, idx);
+	diag_show_u64s(m, name, d->hist_since_irq, DIAG_HIST);
+	snprintf(name, sizeof(name), "hist %s%d gap", kind, idx);
+	diag_show_u64s(m, name, d->hist_gap, DIAG_HIST);
+	snprintf(name, sizeof(name), "hist %s%d n", kind, idx);
+	diag_show_u64s(m, name, d->hist_n, DIAG_HIST);
+	snprintf(name, sizeof(name), "hist %s%d q", kind, idx);
+	diag_show_u64s(m, name, d->hist_q, DIAG_HIST);
+}
+
+static int diag_summary_show(struct seq_file *m, void *unused)
+{
+	struct ppe_device *ppe_dev = diag.ppe_dev;
+	struct edma *edma = &ppe_dev->edma;
+	struct diag_thread *t;
+	struct diag_cpu *c;
+	char name[40];
+	int cpu, i;
+
+	seq_printf(m, "now %llu\n", diag_now());
+	seq_printf(m, "window start=%llu stop=%llu\n", diag.win_start,
+		   diag.win_stop);
+	seq_printf(m, "config diag_on=%d probes=%d poll_size=%zu diag_cap=%u num_rx=%u num_txcmpl=%u rx_buffer_size=%u\n",
+		   diag_on, diag.probes, sizeof(struct diag_poll), diag_cap,
+		   edma->num_rx, edma->num_txcmpl, edma->rx_buffer_size);
+
+	for (i = 0; i < edma->num_rx; i++)
+		diag_show_ring(m, "rx", i, &edma->rxdesc[i]);
+	for (i = 0; i < edma->num_txcmpl; i++)
+		diag_show_ring(m, "tx", i, &edma->txcmpl[i]);
+
+	for (i = 0; i < ARRAY_SIZE(ppe_dev->ports); i++) {
+		struct ppe_port *port = ppe_dev->ports[i];
+
+		if (!port)
+			continue;
+
+		seq_printf(m, "port %d name=%s num_txq=%u tx_ring_base=%u tx_cmpl_base=%u\n",
+			   i, port->netdev->name, port->num_txq,
+			   port->tx_ring_base, port->tx_cmpl_base);
+	}
+
+	for_each_online_cpu(cpu) {
+		c = per_cpu_ptr(&diag_cpu, cpu);
+
+		seq_printf(m, "cpu %d since=%llu\n", cpu, c->since);
+		snprintf(name, sizeof(name), "cpu %d irq_ns", cpu);
+		diag_show_u64s(m, name, c->irq_ns, DIAG_I_NUM);
+		snprintf(name, sizeof(name), "cpu %d irq_cnt", cpu);
+		diag_show_u64s(m, name, c->irq_cnt, DIAG_I_NUM);
+		snprintf(name, sizeof(name), "cpu %d sirq_ns", cpu);
+		diag_show_u64s(m, name, c->sirq_ns, NR_SOFTIRQS);
+		snprintf(name, sizeof(name), "cpu %d sirq_cnt", cpu);
+		diag_show_u64s(m, name, c->sirq_cnt, NR_SOFTIRQS);
+		snprintf(name, sizeof(name), "cpu %d sirq_ksoftirqd_ns", cpu);
+		diag_show_u64s(m, name, c->sirq_ksoftirqd_ns, NR_SOFTIRQS);
+		snprintf(name, sizeof(name), "cpu %d task_ns", cpu);
+		diag_show_u64s(m, name, c->task_ns, DIAG_T_NUM);
+		snprintf(name, sizeof(name), "cpu %d task_sw", cpu);
+		diag_show_u64s(m, name, c->task_sw, DIAG_T_NUM);
+		for (i = 0; i < DIAG_X_NUM; i++)
+			seq_printf(m, "cpu %d xmit %s loc=%llu fwd=%llu loc_bytes=%llu fwd_bytes=%llu ns=%llu\n",
+				   cpu, diag_xmit_name[i], c->x_pkts[i][1],
+				   c->x_pkts[i][0], c->x_bytes[i][1],
+				   c->x_bytes[i][0], c->x_ns[i]);
+		seq_printf(m, "cpu %d xmit_busy=%llu xmit_nonlinear=%llu gen_wait_ns=%llu gen_wait_cnt=%llu gen_wait_max=%llu\n",
+			   cpu, c->x_busy, c->x_nonlinear, c->gen_wait_ns,
+			   c->gen_wait_cnt, c->gen_wait_max);
+		snprintf(name, sizeof(name), "cpu %d hist_gen_wait", cpu);
+		diag_show_u64s(m, name, c->hist_gen_wait, DIAG_HIST);
+	}
+
+	seq_puts(m, "task_classes");
+	for (i = 0; i < DIAG_T_NUM; i++)
+		seq_printf(m, " %s", diag_task_name[i]);
+	seq_putc(m, '\n');
+
+	for (i = 0; i < DIAG_THREADS; i++) {
+		t = &diag_thread[i];
+		if (!t->task)
+			continue;
+
+		seq_printf(m, "thread %s%d pid=%d cpu=%u policy=%u nice=%d wake_ns=%llu wake_cnt=%llu wake_max=%llu pre_ns=%llu pre_cnt=%llu pre_max=%llu\n",
+			   i < EDMA_MAX_RX_GROUPS ? "rx" : "tx",
+			   i % EDMA_MAX_RX_GROUPS, t->task->pid,
+			   task_cpu(t->task), t->task->policy,
+			   task_nice(t->task), t->wake_ns, t->wake_cnt,
+			   t->wake_max, t->pre_ns, t->pre_cnt, t->pre_max);
+		snprintf(name, sizeof(name), "hist thread%d wake", i);
+		diag_show_u64s(m, name, t->hist_wake, DIAG_HIST);
+		snprintf(name, sizeof(name), "hist thread%d pre", i);
+		diag_show_u64s(m, name, t->hist_pre, DIAG_HIST);
+	}
+
+	/* The totals over the window if it has ended, else since it began */
+	if (!diag.win_stop)
+		diag_txq_totals(diag_txq_end);
+	for (i = 0; i < diag_ntxq; i++) {
+		u32 now_val[DIAG_TXQ_SAMPLE];
+
+		diag_txq_sample(i, now_val);
+		seq_printf(m, "txq %s-%u packets=%llu stopped=%llu woken=%llu rewoken=%llu qdisc_drops=%llu qdisc_requeues=%llu inflight=%u limit=%u qlen=%u backlog=%u\n",
+			   diag_txq[i].port->netdev->name, diag_txq[i].queue,
+			   diag_txq_end[i][0] - diag_txq_base[i][0],
+			   diag_txq_end[i][1] - diag_txq_base[i][1],
+			   diag_txq_end[i][2] - diag_txq_base[i][2],
+			   diag_txq_end[i][3] - diag_txq_base[i][3],
+			   diag_txq_end[i][4] - diag_txq_base[i][4],
+			   diag_txq_end[i][5] - diag_txq_base[i][5],
+			   now_val[0], now_val[1], now_val[2], now_val[3]);
+	}
+
+	for (i = 0; i < DIAG_MARKS; i++)
+		if (diag_mark[i].at)
+			seq_printf(m, "mark %u %llu\n", diag_mark[i].seq,
+				   diag_mark[i].at);
+
+	seq_printf(m, "sampler running=%d n=%u cap=%u regs=%u words=%u ns=%llu txqs=%u\n",
+		   diag.running, diag.n, diag.cap, diag.rec_regs,
+		   diag.rec_words, diag.sample_ns, diag_ntxq);
+	seq_printf(m, "watcher done=%d n=%u cap=%u regs=%u loops=%llu ms=%u\n",
+		   diag.wdone, diag.wn, diag.wcap, diag.nwregs, diag.wloops,
+		   diag.wms);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(diag_summary);
+
+/* The NAPI threads and the interrupts exist by now */
+void ppe_diag_threads(struct ppe_device *ppe_dev)
+{
+	struct edma *edma = &ppe_dev->edma;
+	int i;
+
+	for (i = 0; i < edma->num_rx; i++) {
+		diag_thread[i].task = edma->rxdesc[i].napi.thread;
+		diag_irq_rx[2 * i] = edma->rxdesc[i].irq;
+		diag_irq_rx[2 * i + 1] = edma->rxfill[i].irq;
+	}
+
+	for (i = 0; i < edma->num_txcmpl; i++) {
+		diag_thread[EDMA_MAX_RX_GROUPS + i].task =
+			exp_combined ? NULL : edma->txcmpl[i].napi.thread;
+		diag_irq_tx[i] = edma->txcmpl[i].irq;
+	}
+}
+
+int ppe_diag_init(struct ppe_device *ppe_dev, void __iomem *base)
+{
+	struct edma *edma = &ppe_dev->edma;
+	char name[16];
+	int i, ret;
+
+	diag.ppe_dev = ppe_dev;
+	diag.base = base;
+	hrtimer_setup(&diag.timer, diag_sample_fn, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL_PINNED_HARD);
+	hrtimer_setup(&diag.window, diag_window_fn, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL);
+
+	diag.dir = debugfs_create_dir("ipq807x_diag", NULL);
+	debugfs_create_file("summary", 0444, diag.dir, NULL,
+			    &diag_summary_fops);
+	debugfs_create_file("ctl", 0200, diag.dir, NULL, &diag_ctl_fops);
+	debugfs_create_blob("samples", 0444, diag.dir, &diag.blob);
+	debugfs_create_blob("watch", 0444, diag.dir, &diag.wblob);
+
+	for (i = 0; i < edma->num_rx + edma->num_txcmpl; i++) {
+		bool tx = i >= edma->num_rx;
+		struct edma_ring *ring = tx ? &edma->txcmpl[i - edma->num_rx] :
+					      &edma->rxdesc[i];
+
+		ring->diag.rec = vzalloc(array_size(diag_cap,
+						    sizeof(struct diag_poll)));
+		if (!ring->diag.rec)
+			continue;
+
+		diag.ring_blob[i].data = ring->diag.rec;
+		diag.ring_blob[i].size = (size_t)diag_cap *
+					 sizeof(struct diag_poll);
+		snprintf(name, sizeof(name), "%s%d", tx ? "tx" : "rx",
+			 tx ? i - edma->num_rx : i);
+		debugfs_create_blob(name, 0444, diag.dir, &diag.ring_blob[i]);
+	}
+
+	diag_ntxq = 0;
+	for (i = 0; i < ARRAY_SIZE(ppe_dev->ports); i++) {
+		struct ppe_port *port = ppe_dev->ports[i];
+		int q;
+
+		for (q = 0; port && q < port->num_txq && diag_ntxq < DIAG_TXQS; q++) {
+			diag_txq[diag_ntxq].port = port;
+			diag_txq[diag_ntxq++].queue = q;
+		}
+	}
+
+	on_each_cpu(diag_reset_cpu, NULL, 1);
+	for_each_possible_cpu(i)
+		per_cpu_ptr(&diag_cpu, i)->cur_vec = -1;
+
+	for_each_kernel_tracepoint(diag_tp_find, NULL);
+	for (i = 0; i < ARRAY_SIZE(diag_tp); i++)
+		if (!diag_tp[i])
+			return 0;
+
+	for (i = 0; i < ARRAY_SIZE(diag_tp); i++) {
+		ret = tracepoint_probe_register(diag_tp[i], diag_probe[i], NULL);
+		if (ret) {
+			while (i--)
+				tracepoint_probe_unregister(diag_tp[i],
+							    diag_probe[i], NULL);
+			return 0;
+		}
+	}
+	diag.probes = true;
+
+	return 0;
+}
+
+/* Before the netdevs go: nothing reads a TX queue or records from here on */
+void ppe_diag_quiesce(void)
+{
+	hrtimer_cancel(&diag.window);
+	WRITE_ONCE(diag_on, false);
+	hrtimer_cancel(&diag.timer);
+	diag.running = false;
+	diag_ntxq = 0;
+}
+
+void ppe_diag_exit(struct ppe_device *ppe_dev)
+{
+	struct edma *edma = &ppe_dev->edma;
+	int i;
+
+	hrtimer_cancel(&diag.window);
+	diag_on = false;
+	hrtimer_cancel(&diag.timer);
+	while (diag.watcher)
+		msleep(20);
+
+	if (diag.probes) {
+		for (i = 0; i < ARRAY_SIZE(diag_tp); i++)
+			tracepoint_probe_unregister(diag_tp[i], diag_probe[i],
+						    NULL);
+		tracepoint_synchronize_unregister();
+		diag.probes = false;
+	}
+
+	debugfs_remove_recursive(diag.dir);
+	vfree(diag.buf);
+	vfree(diag.wbuf);
+	diag.buf = NULL;
+	diag.wbuf = NULL;
+
+	for (i = 0; i < edma->num_rx; i++) {
+		vfree(edma->rxdesc[i].diag.rec);
+		edma->rxdesc[i].diag.rec = NULL;
+	}
+	for (i = 0; i < edma->num_txcmpl; i++) {
+		vfree(edma->txcmpl[i].diag.rec);
+		edma->txcmpl[i].diag.rec = NULL;
+	}
+	memset(diag_thread, 0, sizeof(diag_thread));
+}
