+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * E-0007 experiment only: what the driver records about itself and what can
+ * be switched to something else than the driver does. See ppe_diag.c.
+ */
+
+#ifndef __IPQ807X_PPE_DIAG_H
+#define __IPQ807X_PPE_DIAG_H
+
+#include <linux/io.h>
+#include <linux/regmap.h>
+#include <linux/timekeeping.h>
+
+struct ppe_device;
+struct edma_ring;
+struct sk_buff;
+
+/* Given when the module is loaded */
+extern unsigned int exp_no_fc;
+extern unsigned int exp_tx_thread;
+extern unsigned int exp_rx_softirq;
+extern unsigned int exp_combined;
+extern unsigned int exp_rx_weight;
+extern unsigned int exp_tx_weight;
+extern unsigned int exp_cmpl_shift;
+extern unsigned int exp_rx_mod;
+extern unsigned int exp_tx_mod;
+extern unsigned int exp_rx_ring;
+extern unsigned int exp_tx_ring;
+extern unsigned int exp_txcmpl_ring;
+extern unsigned int exp_bm_react;
+extern unsigned int exp_bm_ceiling;
+extern unsigned int exp_bm_weight;
+extern unsigned int exp_bm_group;
+extern unsigned int exp_bm_resume;
+extern unsigned int exp_raw_io;
+extern unsigned int exp_page_idx;
+extern unsigned int exp_sync_len;
+extern unsigned int exp_rx_hardirq;
+extern unsigned int exp_defer_irqs;
+extern unsigned int exp_gro_flush_us;
+extern unsigned int exp_cpu_q_ceiling;
+extern unsigned int exp_tx_hardirq;
+
+/* Can be written while the driver runs */
+extern bool diag_on;
+extern bool diag_xmit_time;
+extern unsigned int exp_tx_budget;
+extern unsigned int exp_rx_drop_port;
+extern unsigned int exp_rx_delay_us;
+extern unsigned int exp_fill_lag;
+extern unsigned int exp_cons_lag;
+extern unsigned int exp_fill_every;
+extern unsigned int exp_tx_scan_extra;
+extern unsigned int exp_hardirq_budget;
+extern unsigned int exp_rx_swq;
+
+/* What one poll of an RX ring or of a TX completion ring did */
+struct diag_poll {
+	u64 start;		/* ns, monotonic */
+	u32 dur;		/* ns */
+	u32 since_irq;		/* ns from the interrupt that asked for it; ~0: none did */
+	u32 gap;		/* ns since the previous poll of this ring ended */
+	u32 xmit_ns;		/* ns this CPU spent in the driver's xmit meanwhile */
+	u16 n;			/* slots looked at */
+	u16 frames;		/* RX: frames handed up or dropped whole */
+	u16 fwd;		/* RX: of those, not for an address of the router */
+	u16 loc;		/* RX: for the router, with payload */
+	u16 ack;		/* RX: for the router, TCP without payload */
+	u16 scan;		/* RX: store slots walked to find pages */
+	u16 q_in;		/* slots waiting when the poll began */
+	u16 q_out;		/* slots waiting when it ended */
+	u16 xmit_loc;		/* packets with a socket this CPU sent meanwhile */
+	u16 xmit_fwd;		/* packets without one */
+	u16 woken;		/* TX: queues woken */
+	u16 refill;		/* RX: new buffers put into the fill ring */
+	u16 p_in;		/* the ring's producer and consumer positions */
+	u16 c_in;		/* when the poll began, */
+	u16 p_out;		/* and when it ended */
+	u16 c_out;
+	u16 after_loc;		/* TX: packets with a socket this CPU sent from
+				 * softirqs since this ring's poll before
+				 */
+	u8 cpu;
+	u8 flags;
+	u32 pid;
+};
+
+#define DIAG_POLL_SOFTIRQ	BIT(0)	/* ran in a softirq, not in a NAPI thread */
+#define DIAG_POLL_KSOFTIRQD	BIT(1)	/* that softirq ran in ksoftirqd */
+#define DIAG_POLL_BUDGET	BIT(2)	/* used up its budget */
+#define DIAG_POLL_TX		BIT(3)	/* a TX completion ring's */
+#define DIAG_POLL_HARDIRQ	BIT(4)	/* ran in the interrupt handler */
+
+#define DIAG_HIST	24
+
+/* Totals of all polls of one ring since the last reset, and the last
+ * diag_cap of them
+ */
+struct diag_ring {
+	struct diag_poll *rec;
+	u64 polls;
+	u64 dur;
+	u64 n;
+	u64 frames;
+	u64 fwd;
+	u64 loc;
+	u64 ack;
+	u64 scan;
+	u64 scans;
+	u64 dropped;
+	u64 xmit_loc;
+	u64 xmit_fwd;
+	u64 xmit_ns;
+	u64 woken;
+	u64 budget;
+	u64 from_irq;
+	u64 irqs;
+	/* exp_rx_hardirq: frames handed to the stack from the software queue,
+	 * frames that did not fit into it, pages that could not be given back
+	 */
+	u64 swq_done;
+	u64 swq_drop;
+	u64 leaked;
+	u64 hist_since_irq[DIAG_HIST];
+	u64 hist_gap[DIAG_HIST];
+	u64 hist_n[DIAG_HIST];
+	u64 hist_q[DIAG_HIST];
+	u64 irq_ts;
+	u64 last_end;
+	/* The poll in progress */
+	struct diag_poll cur;
+	u64 cur_xmit_loc;
+	u64 cur_xmit_fwd;
+	u64 cur_xmit_ns;
+	u64 soft_loc_at_end;
+	u8 saved_in_poll;
+};
+
+static inline u64 diag_now(void)
+{
+	return ktime_get_mono_fast_ns();
+}
+
+int ppe_diag_init(struct ppe_device *ppe_dev, void __iomem *base);
+void ppe_diag_exit(struct ppe_device *ppe_dev);
+void ppe_diag_quiesce(void);
+void ppe_diag_threads(struct ppe_device *ppe_dev);
+
+void diag_irq(struct edma_ring *ring);
+void diag_poll_begin(struct edma_ring *ring, bool tx);
+void diag_poll_end(struct edma_ring *ring, int done, int budget, u16 q_out);
+bool diag_rx_frame(struct edma_ring *ring, const void *frame, unsigned int len);
+void diag_xmit_begin(struct sk_buff *skb, u64 *start, bool *local);
+void diag_xmit_end(u64 start, bool local, unsigned int len, bool busy);
+void diag_in_poll(u8 kind);
+
+#endif /* __IPQ807X_PPE_DIAG_H */
