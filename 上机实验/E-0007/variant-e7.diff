+ * that CPU with interrupts or bottom halves off, but for being read.
+ */
+struct diag_cpu {
+	u64 since;
+	u64 switch_ts;
+	u64 stolen;
+	u64 irq_ts;
+	u64 sirq_ts;
+	u64 sirq_stolen;
+	int cur_vec;
+	u8 cur_class;
+	u8 in_poll;
