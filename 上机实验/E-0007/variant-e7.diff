+	u64 irq_cnt[DIAG_I_NUM];
+	u64 sirq_ns[NR_SOFTIRQS];
+	u64 sirq_cnt[NR_SOFTIRQS];
+	u64 sirq_ksoftirqd_ns[NR_SOFTIRQS];
+	u64 task_ns[DIAG_T_NUM];
+	u64 task_sw[DIAG_T_NUM];
+
+	u64 x_pkts[DIAG_X_NUM][2];
+	u64 x_bytes[DIAG_X_NUM][2];
+	u64 x_ns[DIAG_X_NUM];
+	u64 x_busy;
+	u64 x_nonlinear;
+	/* Never reset: the polls take differences */
+	u64 x_loc;
+	u64 x_fwd;
+	u64 x_ns_all;
+	u64 x_soft_loc;
+
+	/* How long the generators' tasks that ran here had waited for a CPU */
+	u64 gen_wait_ns;
+	u64 gen_wait_cnt;
+	u64 gen_wait_max;
+	u64 hist_gen_wait[DIAG_HIST];
+};
