+/* E-0007 experiment only: a ring's register in a poll or in xmit, with
+ * exp_raw_io without the register map's lock
+ */
+static inline u32 edma_hot_read(struct ppe_device *ppe_dev, u32 reg)
+{
+	u32 val;
+
+	if (exp_raw_io)
+		return readl(ppe_dev->diag_base + reg);
