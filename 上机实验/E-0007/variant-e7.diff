+
+static void diag_hist_add(u64 *hist, u64 val)
+{
+	hist[min_t(unsigned int, fls64(val), DIAG_HIST - 1)]++;
+}
+
+static struct diag_thread *diag_thread_of(struct task_struct *p)
+{
+	int i;
+
+	for (i = 0; i < DIAG_THREADS; i++)
+		if (diag_thread[i].task == p)
+			return &diag_thread[i];
+
+	return NULL;
+}
+
+static u8 diag_task_class(struct task_struct *p)
+{
+	struct diag_thread *t;
+
+	if (is_idle_task(p))
+		return DIAG_T_IDLE;
+
+	t = diag_thread_of(p);
+	if (t)
+		return t - diag_thread < EDMA_MAX_RX_GROUPS ? DIAG_T_RX :
+							      DIAG_T_TX;
+
+	if (!strncmp(p->comm, "iperf3", 6) || !strncmp(p->comm, "kpktgend", 8))
+		return DIAG_T_GEN;
+	if (!strncmp(p->comm, "ksoftirqd", 9))
+		return DIAG_T_KSOFTIRQD;
+	if (!strncmp(p->comm, "kworker", 7))
+		return DIAG_T_KWORKER;
+
+	return DIAG_T_OTHER;
+}
+
+static void diag_probe_switch(void *data, bool preempt,
+			      struct task_struct *prev,
+			      struct task_struct *next,
+			      unsigned int prev_state)
+{
+	struct diag_cpu *c = this_cpu_ptr(&diag_cpu);
+	struct diag_thread *t;
+	u64 now = diag_now();
+	u64 from, wait;
+
+	if (diag_on) {
+		c->task_ns[c->cur_class] += now - c->switch_ts - c->stolen;
+		c->task_sw[c->cur_class]++;
+	}
+	c->switch_ts = now;
+	c->stolen = 0;
+	c->cur_class = diag_task_class(next);
+
+	if (prev_state == TASK_RUNNING && diag_task_class(prev) == DIAG_T_GEN) {
+		diag_gen[prev->pid % DIAG_GEN_SLOTS].pid = prev->pid;
+		diag_gen[prev->pid % DIAG_GEN_SLOTS].from = now;
+	}
+	if (c->cur_class == DIAG_T_GEN &&
+	    diag_gen[next->pid % DIAG_GEN_SLOTS].pid == next->pid) {
+		from = diag_gen[next->pid % DIAG_GEN_SLOTS].from;
+		diag_gen[next->pid % DIAG_GEN_SLOTS].from = 0;
+		if (from && diag_on) {
+			c->gen_wait_ns += now - from;
+			c->gen_wait_cnt++;
+			c->gen_wait_max = max(c->gen_wait_max, now - from);
+			diag_hist_add(c->hist_gen_wait, now - from);
+		}
+	}
+
+	t = diag_thread_of(prev);
+	if (t) {
+		t->preempted = prev_state == TASK_RUNNING;
+		WRITE_ONCE(t->wait_from, t->preempted ? now : 0);
+	}
+
+	t = diag_thread_of(next);
+	if (!t)
+		return;
+
+	from = READ_ONCE(t->wait_from);
+	if (!from)
+		return;
+
+	WRITE_ONCE(t->wait_from, 0);
+	if (!diag_on)
+		return;
+
+	wait = now - from;
+	if (t->preempted) {
+		t->pre_ns += wait;
+		t->pre_cnt++;
+		t->pre_max = max(t->pre_max, wait);
+		diag_hist_add(t->hist_pre, wait);
+	} else {
+		t->wake_ns += wait;
+		t->wake_cnt++;
+		t->wake_max = max(t->wake_max, wait);
+		diag_hist_add(t->hist_wake, wait);
+	}
+}
+
+static void diag_probe_waking(void *data, struct task_struct *p)
+{
+	struct diag_thread *t = diag_thread_of(p);
+
+	if (!t && diag_task_class(p) == DIAG_T_GEN) {
+		diag_gen[p->pid % DIAG_GEN_SLOTS].pid = p->pid;
+		diag_gen[p->pid % DIAG_GEN_SLOTS].from = diag_now();
+		return;
+	}
+
+	if (t && !READ_ONCE(t->wait_from)) {
+		t->preempted = false;
+		WRITE_ONCE(t->wait_from, diag_now());
+	}
+}
+
+static void diag_probe_irq_entry(void *data, int irq, struct irqaction *action)
+{
+	this_cpu_ptr(&diag_cpu)->irq_ts = diag_now();
+}
+
+static void diag_probe_irq_exit(void *data, int irq, struct irqaction *action,
+				int ret)
+{
+	struct diag_cpu *c = this_cpu_ptr(&diag_cpu);
+	u64 dt = diag_now() - c->irq_ts;
+	int cls = DIAG_I_OTHER;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(diag_irq_rx); i++)
+		if (diag_irq_rx[i] == irq)
+			cls = DIAG_I_RX;
+	for (i = 0; i < ARRAY_SIZE(diag_irq_tx); i++)
+		if (diag_irq_tx[i] == irq)
+			cls = DIAG_I_TX;
+
+	if (diag_on) {
+		c->irq_ns[cls] += dt;
+		c->irq_cnt[cls]++;
+	}
+	c->stolen += dt;
+	if (c->cur_vec >= 0)
+		c->sirq_stolen += dt;
+}
+
+static void diag_probe_softirq_entry(void *data, unsigned int vec)
+{
+	struct diag_cpu *c = this_cpu_ptr(&diag_cpu);
+
+	c->cur_vec = vec;
+	c->sirq_ts = diag_now();
+	c->sirq_stolen = 0;
+}
+
+static void diag_probe_softirq_exit(void *data, unsigned int vec)
+{
+	struct diag_cpu *c = this_cpu_ptr(&diag_cpu);
+	u64 dt;
+
+	if (c->cur_vec < 0 || vec >= NR_SOFTIRQS)
+		return;
+
+	dt = diag_now() - c->sirq_ts - c->sirq_stolen;
+	if (diag_on) {
+		c->sirq_ns[vec] += dt;
+		c->sirq_cnt[vec]++;
+		if (c->cur_class == DIAG_T_KSOFTIRQD)
+			c->sirq_ksoftirqd_ns[vec] += dt;
+	}
+	c->stolen += dt;
+	c->cur_vec = -1;
+}
+
+static void * const diag_probe[ARRAY_SIZE(diag_tp_name)] = {
+	diag_probe_switch, diag_probe_waking, diag_probe_irq_entry,
+	diag_probe_irq_exit, diag_probe_softirq_entry, diag_probe_softirq_exit,
+};
