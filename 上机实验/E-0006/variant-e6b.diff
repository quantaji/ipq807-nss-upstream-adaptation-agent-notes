+#include <linux/module.h>
 #include <linux/netdevice.h>
 #include <linux/of.h>
 #include <linux/of_irq.h>
@@ -27,6 +28,73 @@
 #include "ppe.h"
 #include "edma_regs.h"
 
+/* E-0006 experiment only. With none of the parameters given the module does
+ * what the driver does.
+ *
+ * Given when the module is loaded:
+ * exp_no_fc: 1 turns flow control off for the eight buffer manager ports on
+ * the CPU side, so that what the host sends is not held back.
+ * exp_tx_thread: 1 polls the TX completion rings in threads, like the RX
+ * rings.
+ * exp_rx_mod, exp_tx_mod: what is written to the moderation timers of the RX
+ * rings and of the TX completion rings.
+ * exp_maxframe: 1 lets frames of up to 16383 bytes through and an MTU of up
+ * to 16357 be set, with the 10G MAC's receive watchdog off.
+ *
+ * Can be written while the driver runs:
+ * exp_fail_alloc: 1 treats every attempt to get a new page in the RX poll as
+ * failed.
+ * exp_starve_ring: the RX ring of that index hands its frames up but puts no
+ * buffer back, so its fill ring drains; -1 for none.
+ * exp_bad_page: 1 makes the RX poll treat the next page as not in the store,
+ * once.
+ * exp_bad_cmpl: 1 makes the TX completion poll read the next completion as
+ * naming a slot that is not there, once.
+ * exp_misc_stat: what is written goes to the error status register.
+ */
+unsigned int exp_no_fc;
+module_param(exp_no_fc, uint, 0444);
+unsigned int exp_tx_thread;
+module_param(exp_tx_thread, uint, 0444);
+unsigned int exp_rx_mod = EDMA_RX_MOD_TIMER_INIT;
+module_param(exp_rx_mod, uint, 0444);
+unsigned int exp_tx_mod = EDMA_TX_MOD_TIMER;
+module_param(exp_tx_mod, uint, 0444);
+unsigned int exp_maxframe;
+module_param(exp_maxframe, uint, 0444);
+bool exp_fail_alloc;
+module_param(exp_fail_alloc, bool, 0644);
+int exp_starve_ring = -1;
+module_param(exp_starve_ring, int, 0644);
+unsigned int exp_bad_page;
+module_param(exp_bad_page, uint, 0644);
+unsigned int exp_bad_cmpl;
+module_param(exp_bad_cmpl, uint, 0644);
+
+static struct ppe_device *exp_ppe_dev;
+
+static int exp_misc_stat_set(const char *val, const struct kernel_param *kp)
+{
+	u32 stat;
+	int ret;
+
+	ret = kstrtou32(val, 0, &stat);
+	if (ret)
+		return ret;
+	if (!exp_ppe_dev)
+		return -ENODEV;
+
+	regmap_write(exp_ppe_dev->regmap,
+		     EDMA_BASE_OFFSET + EDMA_REG_MISC_INT_STAT, stat);
+
+	return 0;
+}
+
+static const struct kernel_param_ops exp_misc_stat_ops = {
+	.set = exp_misc_stat_set,
+};
+module_param_cb(exp_misc_stat, &exp_misc_stat_ops, NULL, 0200);
+
 /* Bring the whole EDMA to a known state: reset it, mask every ring
  * interrupt, switch every ring and the block itself off, and write the two
  * settings that are not a ring's. This is the one place that touches rings
@@ -654,6 +722,8 @@
 	}
 	strscpy(edma->tx_napi_dev->name, "edma_tx",
 		sizeof(edma->tx_napi_dev->name));
+	if (exp_tx_thread)
+		netif_threaded_enable(edma->tx_napi_dev);
 
 	for (i = 0; i < edma->num_rx; i++)
 		netif_napi_add(edma->rx_napi_dev, &edma->rxdesc[i].napi,
@@ -743,6 +813,7 @@
 		goto err_sys_clk;
 
 	edma->num_rx = ppe_dev->num_rx_groups;
+	exp_ppe_dev = ppe_dev;
 	spin_lock_init(&edma->misc_lock);
 	INIT_WORK(&edma->fault_work, edma_fault_work);
 
@@ -843,6 +914,7 @@
 
 	edma_irq_free(ppe_dev);
 	cancel_work_sync(&edma->fault_work);
+	exp_ppe_dev = NULL;
 
 	edma_host_rings_stop(ppe_dev);
 
