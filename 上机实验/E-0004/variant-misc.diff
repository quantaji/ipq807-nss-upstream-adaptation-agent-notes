 #include "ppe.h"
 #include "edma_regs.h"
 
+/* E-0004 experiment only: writing to the parameter exp_misc_trigger points
+ * TX ring 8, which nothing uses, at a bus address that does not exist and
+ * has the hardware fetch one packet from it.
+ */
+static struct ppe_device *exp_ppe_dev;
+
+static int exp_misc_trigger_set(const char *val, const struct kernel_param *kp)
+{
+	struct regmap *regmap;
+	u32 cons;
+
+	if (!exp_ppe_dev)
+		return -ENODEV;
+
+	regmap = exp_ppe_dev->regmap;
+	regmap_write(regmap, EDMA_BASE_OFFSET + EDMA_REG_TXDESC_BA(8),
+		     0xfffff000);
+	regmap_write(regmap, EDMA_BASE_OFFSET + EDMA_REG_TXDESC_RING_SIZE(8),
+		     EDMA_TX_RING_SIZE);
+	regmap_read(regmap, EDMA_BASE_OFFSET + EDMA_REG_TXDESC_CONS_IDX(8),
+		    &cons);
+	regmap_set_bits(regmap, EDMA_BASE_OFFSET + EDMA_REG_TXDESC_CTRL(8),
+			EDMA_TXDESC_TX_EN);
+	regmap_write(regmap, EDMA_BASE_OFFSET + EDMA_REG_TXDESC_PROD_IDX(8),
+		     (cons + 1) & (EDMA_TX_RING_SIZE - 1));
+
+	return 0;
+}
+
+static const struct kernel_param_ops exp_misc_trigger_ops = {
+	.set = exp_misc_trigger_set,
+};
+module_param_cb(exp_misc_trigger, &exp_misc_trigger_ops, NULL, 0200);
