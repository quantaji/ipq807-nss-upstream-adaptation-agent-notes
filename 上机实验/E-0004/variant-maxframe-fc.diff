+#include <linux/module.h>
 #include <linux/netdevice.h>
 #include <linux/of.h>
 #include <linux/of_irq.h>
@@ -27,6 +28,72 @@
 #include "ppe.h"
 #include "edma_regs.h"
 
+/* E-0004 experiment only: reading the parameter exp_rings gives the misc
+ * status word and mask and, for each of the host's TX rings and TX
+ * completion rings, where the hardware and the driver stand in it.
+ */
+static struct ppe_device *exp_ppe_dev;
+
+static int exp_rings_get(char *buf, const struct kernel_param *kp)
+{
+	const struct ppe_soc_data *soc;
+	struct edma_ring *ring;
+	struct regmap *regmap;
+	u32 prod, cons, ctrl;
+	int i, held, slot;
+	int len = 0;
+
+	if (!exp_ppe_dev)
+		return -ENODEV;
+
+	soc = exp_ppe_dev->soc;
+	regmap = exp_ppe_dev->regmap;
+
+	regmap_read(regmap, EDMA_BASE_OFFSET + EDMA_REG_MISC_INT_STAT, &prod);
+	regmap_read(regmap, EDMA_BASE_OFFSET + EDMA_REG_MISC_INT_MASK, &cons);
+	len += sysfs_emit_at(buf, len, "misc stat %#x mask %#x\n", prod, cons);
+
+	for (i = 0; i < ARRAY_SIZE(exp_ppe_dev->edma.txdesc); i++) {
+		ring = &exp_ppe_dev->edma.txdesc[i];
+		if (!ring->desc)
+			continue;
+
+		regmap_read(regmap, EDMA_BASE_OFFSET +
+			    EDMA_REG_TXDESC_PROD_IDX(ring->id), &prod);
+		regmap_read(regmap, EDMA_BASE_OFFSET +
+			    EDMA_REG_TXDESC_CONS_IDX(ring->id), &cons);
+		regmap_read(regmap, EDMA_BASE_OFFSET +
+			    EDMA_REG_TXDESC_CTRL(ring->id), &ctrl);
+		held = 0;
+		for (slot = 0; slot < ring->count; slot++)
+			if (ring->skb_store[slot])
+				held++;
+		len += sysfs_emit_at(buf, len,
+				     "tx %u q%d prod %u cons %u ctrl %#x held %d\n",
+				     ring->id, ring->queue, prod, cons, ctrl,
+				     held);
+	}
+
+	for (i = 0; i < exp_ppe_dev->edma.num_txcmpl; i++) {
+		ring = &exp_ppe_dev->edma.txcmpl[i];
+		regmap_read(regmap, EDMA_BASE_OFFSET +
+			    EDMA_REG_TXCMPL_PROD_IDX(soc->edma_txcmpl_base,
+						     ring->id), &prod);
+		regmap_read(regmap, EDMA_BASE_OFFSET +
+			    EDMA_REG_TXCMPL_CONS_IDX(soc->edma_txcmpl_base,
+						     ring->id), &cons);
+		len += sysfs_emit_at(buf, len, "txcmpl %u prod %u cons %u\n",
+				     ring->id, prod, cons);
+	}
+
+	return len;
+}
+
+static const struct kernel_param_ops exp_rings_ops = {
+	.get = exp_rings_get,
+};
+module_param_cb(exp_rings, &exp_rings_ops, NULL, 0444);
+
 /* Bring the whole EDMA to a known state: reset it, mask every ring
  * interrupt, switch every ring and the block itself off, and write the two
  * settings that are not a ring's. This is the one place that touches rings
@@ -624,6 +691,7 @@
 		edma_rx_irq_set(&edma->rxdesc[i], true);
 
 	of_node_put(np);
+	exp_ppe_dev = ppe_dev;
 
 	return 0;
 
