diff -u -r a/ipq807x/edma_rx.c b/ipq807x/edma_rx.c
--- a/ipq807x/edma_rx.c	2026-11-19 00:34:40.100787047 -0700
+++ b/ipq807x/edma_rx.c	2026-11-19 00:34:40.103054771 -0700
@@ -20,6 +20,18 @@
 #include "ppe.h"
 #include "edma_regs.h"
 
+/* E-0004 experiment only: this file reads and writes its registers directly.
+ * Through the register map every access takes the one lock of that map, with
+ * interrupts off, on whichever CPU it runs; all of them are single reads and
+ * writes of registers of one ring, which need no lock.
+ */
+#include <linux/io.h>
+
+#define regmap_read(map, reg, val) \
+	do { (void)(map); *(val) = readl(exp_mmio_base + (reg)); } while (0)
+#define regmap_write(map, reg, val) \
+	do { (void)(map); writel((val), exp_mmio_base + (reg)); } while (0)
+
 /* How many slots of frames spread over several buffers each RX ring logs */
 #define EDMA_RX_FRAME_LOG_MAX 80
 
