+/* E-0005 experiment only: two parameters that rewrite, while the driver runs,
+ * the buffer limits the PPE applies to what the host sends.
+ *
+ * exp_cpu_bm takes "fc ceiling react weight": for each of the eight buffer
+ * manager ports on the CPU side, whether a full port holds the host back (1)
+ * or not (0), and the port's three limits. The driver loads with
+ * "0 250 100 4".
+ *
+ * exp_uni_ac takes "ceiling weight force": for every unicast queue, the two
+ * limits of how many buffers the queue may hold before frames for it are
+ * dropped, and whether frames of a source under flow control are dropped by
+ * these limits as well (1) or not (0). The driver loads with "400 4 0".
+ *
+ * Reading either gives what was last written to it.
+ */
+static struct ppe_device *exp_ppe_dev;
+static char exp_cpu_bm_now[32] = "0 250 100 4";
+static char exp_uni_ac_now[32] = "400 4 0";
+
+static int exp_cpu_bm_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int fc, ceiling, react, weight;
+	int i;
+
+	if (!exp_ppe_dev)
+		return -ENODEV;
+	if (sscanf(val, "%u %u %u %u", &fc, &ceiling, &react, &weight) != 4)
+		return -EINVAL;
+
+	for (i = 0; i < PPE_BM_PHY_START; i++) {
+		regmap_write(exp_ppe_dev->regmap, PPE_BM_FC_MODE(i),
+			     fc ? PPE_BM_FC_EN : 0);
+		regmap_write(exp_ppe_dev->regmap, PPE_BM_PORT_FC_W0(i),
+			     FIELD_PREP(PPE_BM_REACT_LIMIT, react) |
+			     FIELD_PREP(PPE_BM_RESUME_OFF, 36) |
+			     FIELD_PREP(PPE_BM_CEILING_LO, ceiling & 0x7));
+		regmap_write(exp_ppe_dev->regmap, PPE_BM_PORT_FC_W1(i),
+			     FIELD_PREP(PPE_BM_CEILING_HI, ceiling >> 3) |
+			     FIELD_PREP(PPE_BM_WEIGHT, weight) |
+			     PPE_BM_DYNAMIC);
+	}
+
+	snprintf(exp_cpu_bm_now, sizeof(exp_cpu_bm_now), "%u %u %u %u", fc,
+		 ceiling, react, weight);
+
+	return 0;
+}
+
+static int exp_cpu_bm_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%s\n", exp_cpu_bm_now);
+}
+
+static const struct kernel_param_ops exp_cpu_bm_ops = {
+	.set = exp_cpu_bm_set,
+	.get = exp_cpu_bm_get,
+};
+module_param_cb(exp_cpu_bm, &exp_cpu_bm_ops, NULL, 0644);
+
+static int exp_uni_ac_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int ceiling, weight, force;
+	int i;
+
+	if (!exp_ppe_dev)
+		return -ENODEV;
+	if (sscanf(val, "%u %u %u", &ceiling, &weight, &force) != 3)
+		return -EINVAL;
+
+	/* An entry has four words and the hardware takes it only when the
+	 * last one is written: all four go out, as at boot. Bit 2 of the
+	 * first word is the one that has the limits applied to frames of a
+	 * source under flow control.
+	 */
+	for (i = 0; i < PPE_L0_UCAST_QUEUES; i++) {
+		regmap_write(exp_ppe_dev->regmap, PPE_QM_AC_UNI_W0(i),
+			     PPE_AC_EN | (force ? BIT(2) : 0) |
+			     PPE_AC_SHARED_DYNAMIC |
+			     FIELD_PREP(PPE_AC_SHARED_WEIGHT, weight) |
+			     FIELD_PREP(PPE_AC_SHARED_CEILING, ceiling));
+		regmap_write(exp_ppe_dev->regmap, PPE_QM_AC_UNI_W1(i), 0);
+		regmap_write(exp_ppe_dev->regmap, PPE_QM_AC_UNI_W2(i), 0);
+		regmap_write(exp_ppe_dev->regmap, PPE_QM_AC_UNI_W3(i),
+			     FIELD_PREP(PPE_AC_GRN_RESUME_OFF, 36));
+	}
+
+	snprintf(exp_uni_ac_now, sizeof(exp_uni_ac_now), "%u %u %u", ceiling,
+		 weight, force);
+
+	return 0;
+}
+
+static int exp_uni_ac_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%s\n", exp_uni_ac_now);
+}
+
+static const struct kernel_param_ops exp_uni_ac_ops = {
+	.set = exp_uni_ac_set,
+	.get = exp_uni_ac_get,
+};
+module_param_cb(exp_uni_ac, &exp_uni_ac_ops, NULL, 0644);
